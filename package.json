{
  "name": "aura-datadock-db",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.1",
  "publisher": "lucascodev",
  "author": {
    "name": "Lucas Pereira dos Reis"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucascodev/aura-datadock-db"
  },
  "bugs": {
    "url": "https://github.com/lucascodev/aura-datadock-db/issues"
  },
  "keywords": [
    "docker",
    "database",
    "postgres",
    "mysql",
    "mariadb",
    "sql",
    "mcp",
    "ai",
    "er diagram",
    "erd",
    "export",
    "ssh"
  ],
  "categories": [
    "Other",
    "Data Science",
    "AI"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1B3F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "auraDataDockDb",
          "title": "Aura DataDock DB",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "auraDataDockDb": [
        {
          "id": "auraDataDockDb.connections",
          "name": "%view.connections.name%"
        },
        {
          "id": "auraDataDockDb.schema",
          "name": "%view.schema.name%"
        },
        {
          "id": "auraDataDockDb.history",
          "name": "%view.history.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "auraDataDockDb.connections",
        "contents": "%viewsWelcome.connections.contents%"
      },
      {
        "view": "auraDataDockDb.history",
        "contents": "%viewsWelcome.history.contents%"
      },
      {
        "view": "auraDataDockDb.schema",
        "contents": "%viewsWelcome.schema.contents%"
      }
    ],
    "commands": [
      {
        "command": "auraDataDockDb.refresh",
        "title": "%command.refresh.title%",
        "category": "Aura DataDock DB",
        "icon": "$(refresh)"
      },
      {
        "command": "auraDataDockDb.selectConnection",
        "title": "%command.selectConnection.title%",
        "category": "Aura DataDock DB",
        "icon": "$(plug)"
      },
      {
        "command": "auraDataDockDb.newQuery",
        "title": "%command.newQuery.title%",
        "category": "Aura DataDock DB",
        "icon": "$(new-file)"
      },
      {
        "command": "auraDataDockDb.runQuery",
        "title": "%command.runQuery.title%",
        "category": "Aura DataDock DB",
        "icon": "$(play)"
      },
      {
        "command": "auraDataDockDb.openTable",
        "title": "%command.openTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(table)"
      },
      {
        "command": "auraDataDockDb.setPassword",
        "title": "%command.setPassword.title%",
        "category": "Aura DataDock DB",
        "icon": "$(key)"
      },
      {
        "command": "auraDataDockDb.generateSql",
        "title": "%command.generateSql.title%",
        "category": "Aura DataDock DB",
        "icon": "$(sparkle)"
      },
      {
        "command": "auraDataDockDb.setAiApiKey",
        "title": "%command.setAiApiKey.title%",
        "category": "Aura DataDock DB"
      },
      {
        "command": "auraDataDockDb.runFile",
        "title": "%command.runFile.title%",
        "category": "Aura DataDock DB",
        "icon": "$(run-all)"
      },
      {
        "command": "auraDataDockDb.runStatementAt",
        "title": "%command.runStatementAt.title%",
        "category": "Aura DataDock DB"
      },
      {
        "command": "auraDataDockDb.explainQuery",
        "title": "%command.explainQuery.title%",
        "category": "Aura DataDock DB",
        "icon": "$(telescope)"
      },
      {
        "command": "auraDataDockDb.cancelQuery",
        "title": "%command.cancelQuery.title%",
        "category": "Aura DataDock DB",
        "icon": "$(debug-stop)"
      },
      {
        "command": "auraDataDockDb.showDiagram",
        "title": "%command.showDiagram.title%",
        "category": "Aura DataDock DB",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "auraDataDockDb.exportSchema",
        "title": "%command.exportSchema.title%",
        "category": "Aura DataDock DB",
        "icon": "$(export)"
      },
      {
        "command": "auraDataDockDb.exportTable",
        "title": "%command.exportTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(export)"
      },
      {
        "command": "auraDataDockDb.showTableDdl",
        "title": "%command.showTableDdl.title%",
        "category": "Aura DataDock DB",
        "icon": "$(code)"
      },
      {
        "command": "auraDataDockDb.copySelect",
        "title": "%command.copySelect.title%",
        "category": "Aura DataDock DB",
        "icon": "$(copy)"
      },
      {
        "command": "auraDataDockDb.openHistoryEntry",
        "title": "%command.openHistoryEntry.title%",
        "category": "Aura DataDock DB"
      },
      {
        "command": "auraDataDockDb.clearHistory",
        "title": "%command.clearHistory.title%",
        "category": "Aura DataDock DB",
        "icon": "$(clear-all)"
      },
      {
        "command": "auraDataDockDb.addConnection",
        "title": "%command.addConnection.title%",
        "category": "Aura DataDock DB",
        "icon": "$(add)"
      },
      {
        "command": "auraDataDockDb.editConnection",
        "title": "%command.editConnection.title%",
        "category": "Aura DataDock DB",
        "icon": "$(edit)"
      },
      {
        "command": "auraDataDockDb.removeConnection",
        "title": "%command.removeConnection.title%",
        "category": "Aura DataDock DB",
        "icon": "$(trash)"
      },
      {
        "command": "auraDataDockDb.disconnect",
        "title": "%command.disconnect.title%",
        "category": "Aura DataDock DB",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "auraDataDockDb.activateConnection",
        "title": "%command.activateConnection.title%",
        "category": "Aura DataDock DB"
      },
      {
        "command": "auraDataDockDb.filterSchema",
        "title": "%command.filterSchema.title%",
        "category": "Aura DataDock DB",
        "icon": "$(filter)"
      },
      {
        "command": "auraDataDockDb.addRow",
        "title": "%command.addRow.title%",
        "category": "Aura DataDock DB",
        "icon": "$(add)"
      },
      {
        "command": "auraDataDockDb.newTableQuery",
        "title": "%command.newTableQuery.title%",
        "category": "Aura DataDock DB",
        "icon": "$(new-file)"
      },
      {
        "command": "auraDataDockDb.createTable",
        "title": "%command.createTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(new-file)"
      },
      {
        "command": "auraDataDockDb.addColumn",
        "title": "%command.addColumn.title%",
        "category": "Aura DataDock DB",
        "icon": "$(add)"
      },
      {
        "command": "auraDataDockDb.renameTable",
        "title": "%command.renameTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(edit)"
      },
      {
        "command": "auraDataDockDb.truncateTable",
        "title": "%command.truncateTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(clear-all)"
      },
      {
        "command": "auraDataDockDb.dropTable",
        "title": "%command.dropTable.title%",
        "category": "Aura DataDock DB",
        "icon": "$(trash)"
      },
      {
        "command": "auraDataDockDb.renameColumn",
        "title": "%command.renameColumn.title%",
        "category": "Aura DataDock DB",
        "icon": "$(edit)"
      },
      {
        "command": "auraDataDockDb.dropColumn",
        "title": "%command.dropColumn.title%",
        "category": "Aura DataDock DB",
        "icon": "$(trash)"
      },
      {
        "command": "auraDataDockDb.createIndex",
        "title": "%command.createIndex.title%",
        "category": "Aura DataDock DB",
        "icon": "$(list-ordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "auraDataDockDb.addConnection",
          "when": "view == auraDataDockDb.connections",
          "group": "navigation@1"
        },
        {
          "command": "auraDataDockDb.newQuery",
          "when": "view == auraDataDockDb.connections",
          "group": "navigation@2"
        },
        {
          "command": "auraDataDockDb.generateSql",
          "when": "view == auraDataDockDb.connections",
          "group": "navigation@3"
        },
        {
          "command": "auraDataDockDb.refresh",
          "when": "view == auraDataDockDb.connections",
          "group": "navigation@4"
        },
        {
          "command": "auraDataDockDb.clearHistory",
          "when": "view == auraDataDockDb.history",
          "group": "navigation"
        },
        {
          "command": "auraDataDockDb.filterSchema",
          "when": "view == auraDataDockDb.schema",
          "group": "navigation@1"
        },
        {
          "command": "auraDataDockDb.createTable",
          "when": "view == auraDataDockDb.schema",
          "group": "navigation@2"
        },
        {
          "command": "auraDataDockDb.showDiagram",
          "when": "view == auraDataDockDb.schema",
          "group": "navigation@3"
        },
        {
          "command": "auraDataDockDb.refresh",
          "when": "view == auraDataDockDb.schema",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "auraDataDockDb.newQuery",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-/",
          "group": "inline"
        },
        {
          "command": "auraDataDockDb.showDiagram",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-.*-ready$/",
          "group": "inline"
        },
        {
          "command": "auraDataDockDb.newQuery",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-.*-ready$/",
          "group": "1_connection@1"
        },
        {
          "command": "auraDataDockDb.showDiagram",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-.*-ready$/",
          "group": "1_connection@2"
        },
        {
          "command": "auraDataDockDb.exportSchema",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-.*-ready$/",
          "group": "1_connection@3"
        },
        {
          "command": "auraDataDockDb.disconnect",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-.*-ready$/",
          "group": "2_manage@1"
        },
        {
          "command": "auraDataDockDb.setPassword",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-/",
          "group": "2_manage@2"
        },
        {
          "command": "auraDataDockDb.editConnection",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-saved-/",
          "group": "2_manage@3"
        },
        {
          "command": "auraDataDockDb.removeConnection",
          "when": "view == auraDataDockDb.connections && viewItem =~ /^connection-saved-/",
          "group": "2_manage@4"
        },
        {
          "command": "auraDataDockDb.createTable",
          "when": "view == auraDataDockDb.schema && viewItem == namespace",
          "group": "inline"
        },
        {
          "command": "auraDataDockDb.createTable",
          "when": "view == auraDataDockDb.schema && viewItem == namespace",
          "group": "1_schema@1"
        },
        {
          "command": "auraDataDockDb.showDiagram",
          "when": "view == auraDataDockDb.schema && viewItem == namespace",
          "group": "1_schema@2"
        },
        {
          "command": "auraDataDockDb.exportSchema",
          "when": "view == auraDataDockDb.schema && viewItem == namespace",
          "group": "1_schema@3"
        },
        {
          "command": "auraDataDockDb.addRow",
          "when": "view == auraDataDockDb.schema && viewItem == table",
          "group": "inline"
        },
        {
          "command": "auraDataDockDb.openTable",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "1_data@1"
        },
        {
          "command": "auraDataDockDb.addRow",
          "when": "view == auraDataDockDb.schema && viewItem == table",
          "group": "1_data@2"
        },
        {
          "command": "auraDataDockDb.newTableQuery",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "1_data@3"
        },
        {
          "command": "auraDataDockDb.addColumn",
          "when": "view == auraDataDockDb.schema && viewItem == table",
          "group": "2_structure@1"
        },
        {
          "command": "auraDataDockDb.renameTable",
          "when": "view == auraDataDockDb.schema && viewItem == table",
          "group": "2_structure@2"
        },
        {
          "command": "auraDataDockDb.showTableDdl",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "2_structure@3"
        },
        {
          "command": "auraDataDockDb.exportTable",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "3_export@1"
        },
        {
          "command": "auraDataDockDb.copySelect",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "3_export@2"
        },
        {
          "command": "auraDataDockDb.truncateTable",
          "when": "view == auraDataDockDb.schema && viewItem == table",
          "group": "4_danger@1"
        },
        {
          "command": "auraDataDockDb.dropTable",
          "when": "view == auraDataDockDb.schema && viewItem =~ /^(table|view)$/",
          "group": "4_danger@2"
        },
        {
          "command": "auraDataDockDb.renameColumn",
          "when": "view == auraDataDockDb.schema && viewItem == column",
          "group": "1_column@1"
        },
        {
          "command": "auraDataDockDb.createIndex",
          "when": "view == auraDataDockDb.schema && viewItem == column",
          "group": "1_column@2"
        },
        {
          "command": "auraDataDockDb.dropColumn",
          "when": "view == auraDataDockDb.schema && viewItem == column",
          "group": "2_danger@1"
        }
      ],
      "editor/title": [
        {
          "command": "auraDataDockDb.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "auraDataDockDb.runFile",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "auraDataDockDb.explainQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "auraDataDockDb.openTable",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.exportTable",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.showTableDdl",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.copySelect",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.runStatementAt",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.openHistoryEntry",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.editConnection",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.removeConnection",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.disconnect",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.activateConnection",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.addRow",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.newTableQuery",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.addColumn",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.renameTable",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.truncateTable",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.dropTable",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.renameColumn",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.dropColumn",
          "when": "false"
        },
        {
          "command": "auraDataDockDb.createIndex",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "auraDataDockDb.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "auraDataDockDb.runFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "Aura DataDock DB",
      "properties": {
        "auraDataDockDb.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "%setting.readOnly.description%"
        },
        "auraDataDockDb.confirmDestructiveQueries": {
          "type": "boolean",
          "default": true,
          "description": "%setting.confirmDestructiveQueries.description%"
        },
        "auraDataDockDb.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "%setting.maxRows.description%"
        },
        "auraDataDockDb.dockerHost": {
          "type": "string",
          "default": "",
          "description": "%setting.dockerHost.description%",
          "scope": "machine"
        },
        "auraDataDockDb.ai.provider": {
          "type": "string",
          "enum": [
            "vscode",
            "anthropic",
            "openai",
            "ollama"
          ],
          "enumDescriptions": [
            "%setting.ai.provider.enum.vscode%",
            "%setting.ai.provider.enum.anthropic%",
            "%setting.ai.provider.enum.openai%",
            "%setting.ai.provider.enum.ollama%"
          ],
          "default": "vscode",
          "description": "%setting.ai.provider.description%",
          "scope": "machine"
        },
        "auraDataDockDb.ai.model": {
          "type": "string",
          "default": "",
          "description": "%setting.ai.model.description%",
          "scope": "machine"
        },
        "auraDataDockDb.ai.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "%setting.ai.ollamaUrl.description%",
          "scope": "machine"
        },
        "auraDataDockDb.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%setting.mcp.enabled.description%",
          "scope": "machine"
        },
        "auraDataDockDb.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.codeLens.enabled.description%"
        },
        "auraDataDockDb.history.maxEntries": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "%setting.history.maxEntries.description%"
        },
        "auraDataDockDb.connections": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "items": {
            "type": "object"
          },
          "markdownDescription": "%setting.connections.markdownDescription%"
        },
        "auraDataDockDb.table.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 5000,
          "description": "%setting.table.pageSize.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "auraDataDockDb.mcp",
        "label": "Aura DataDock DB"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "test:integration": "node scripts/runIntegrationTests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "echarts": "^6.1.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "l10n": "./l10n"
}
